# --- Rebuildable render artifacts (regenerated by build scripts) ---
# Slide thumbnails ARE committed so the catalog works in a fresh clone
# (regenerate with tools/build-slide-catalog.ps1). Temp render dirs are not.
**/.render-check.json
.tmp-verify/
.tmp-catalog/

# --- Secrets: never commit. Real values live only in .env (see .env.example) ---
.env

# --- App (deck-studio-app): node deps are never used (zero-dependency server),
# but ignore them if a future dep is added, and ignore the generated index. ---
app/node_modules/
app/index.json

# --- Python cache ---
__pycache__/
*.pyc

# --- OS / editor cruft ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp

# NOTE: PDFs are intentionally NOT ignored. Canonical and variant PDFs are the
# shipped artifact and the historical record, and are committed (see SPEC.md §6).

# Local deck materialization cache (agent): never committed
app/.deck-cache/

# --- CONTENT lives in Supabase, not the repo -------------------------------
# The repo is the TOOL only. Content (decks, social outputs, references) lives in
# Supabase Postgres + Storage. The dirs below are BUILD SCRATCH: the CLI
# assembles into one, publishes it, confirms it landed, and the folder is then
# disposable. Their contents are never committed — only each folder's CLAUDE.md.
#
# Deck Studio 2.0 rule (2026-08-01): a new version of a deck is a new
# deck_versions row, NEVER a `<slug>-v2/` folder. See decks/CLAUDE.md.
/decks/*
!/decks/CLAUDE.md
/social/*
!/social/CLAUDE.md
/dump/*
!/dump/CLAUDE.md
/references/
/screenshots/

# --- Local dev / agent tooling (not the deck studio, not content) ----------
/.agents/
/.impeccable/
/skills-lock.json
# Installed Claude skills (e.g. impeccable) — keep the deck workflows in
# .claude/commands/, but not general skills bundled into this repo.
/.claude/skills/

# last30days engine local search index (rebuildable)
research/last30days/library.db
research/last30days/*.db
