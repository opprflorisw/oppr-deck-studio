# Oppr Deck Studio — environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. Nothing in the repo should ever contain a real key.

# Google Gemini API key, used by the (later-phase) image-generation pipeline.
# Get one from Google AI Studio. Image models need a billed (Tier 1) key.
GEMINI_API_KEY=

# Supabase backend (Deck Studio v3: decks live as HTML versions in the backend).
# The app agent and the Python deck tools read these. The secret key is
# server-side only: it lives in the agent process and the CLI tools, and is
# NEVER sent to the browser or committed. URL is https://<project>.supabase.co.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Reserved for future in-browser auth (attribution). Not used yet.
SUPABASE_ANON_KEY=

# Anthropic API key, used ONLY by tools/check-story.py, the advisory narrative
# pass over a composed deck (Deck Studio 3, SPEC §6). It is the one thing in the
# repo that calls a model at build time. Without it the check prints one line and
# exits 0, so a fresh clone with no key still builds decks. Nothing that can FAIL
# a deck depends on this key.
ANTHROPIC_API_KEY=

# MCP audience policy. The MCP spec says a resource server must reject tokens
# not minted for it, so app/lib/mcpauth.mjs requires `aud` to name the MCP URL.
# Supabase issues ordinary user tokens with aud="authenticated"; if its OAuth
# server does the same, set this to 0 to accept a project-scoped token instead.
# Leave it unset to stay strict — the issuer is always checked either way.
MCP_REQUIRE_AUDIENCE=
